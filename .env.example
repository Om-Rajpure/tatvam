# Environment Variables Configuration for Render / Production
# Copy or input these keys into Render Dashboard Environment Variables

# Database Connection (Render MySQL / Aiven / PlanetScale / External MySQL)
DB_HOST=your-mysql-host.render.com
DB_PORT=3306
DB_NAME=tatvam_production_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com
